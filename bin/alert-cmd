#!/bin/sh -e
##:
#h: Usage: ${ALERT_CMD:-alert-cmd} { -V | CMD... }
#h:
#h: Execute command, it it lasts more than a minute or it fails alerts
#h: the user executing ALERT_CMD.
#h:
#h: Default programs: quiet, notify-send
#h: Environment variables: QUIT, NOTIFY_SEND, ALERT_CMD_SECONDS
##:
alert_cmd() {
    local start end duration ret res

    # Skip.
    if test ! -t 1 || test -n "${QUIET}" || quiet >/dev/null 2>&1; then
        "$@"
        return 0
    fi
    
    # Execute command.
    start="$(date +%s)"
    if "$@"; then ret=0 res=Success; else ret=1 res=Failure; fi
    end="$(date +%s)"
    duration=$(( end - start ))
    
    # Execute timed.
    if test "${ret}" = "1" || test "${duration}" -ge "${ALERT_CMD_SECONDS}"; then
        ${NOTIFY_SEND:-notify-send -a} "$1" "${res}" "$*" || true
    fi
    
    return "${ret}"
}
# --------------------------------------------------------------------
: ${ALERT_CMD_SECONDS:=60}
if test @"${SCRNAME:-$(basename "$0")}" = @"alert-cmd"; then
    case "${1}" in
        ''|-h|--help)
            sed -n 's/^ *#h: \{0,1\}//p' "$0"
            ;;
        -V) cat <<-EOF
		ALERT_CMD          : ${ALERT_CMD}
		ALERT_CMD_SECONDS  : ${ALERT_CMD_SECONDS}
		NOTIFY_SEND        : ${NOTIFY_SEND:-notify-send -a}
		EOF
            ;;
        *)  alert_cmd "$@"
            ;;
    esac
    exit 0
fi
